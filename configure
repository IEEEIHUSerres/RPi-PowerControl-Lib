#!/bin/sh
# Thin autotools-style wrapper around CMake so that the usual
# `./configure && make && make check && make distcheck` flow works.
#
# Usage: ./configure [--builddir=DIR] [--prefix=DIR] [extra CMake args...]
set -e

srcdir=$(cd "$(dirname "$0")" && pwd)
builddir=build
prefix=/usr/local
build_type=Release

for arg in "$@"; do
    case "$arg" in
        --builddir=*) builddir=${arg#*=} ;;
        --prefix=*) prefix=${arg#*=} ;;
        --enable-debug) build_type=Debug ;;
        -h|--help)
            sed -n '2,5p' "$0" | sed 's/^# \{0,1\}//'
            exit 0
            ;;
        *) extra="$extra $arg" ;;
    esac
done

if ! command -v cmake >/dev/null 2>&1; then
    echo "configure: error: cmake not found in PATH" >&2
    exit 1
fi

# shellcheck disable=SC2086
cmake -S "$srcdir" -B "$builddir" \
    -DCMAKE_BUILD_TYPE="$build_type" \
    -DCMAKE_INSTALL_PREFIX="$prefix" \
    $extra

cat > config.mk <<CFG
# Generated by ./configure -- do not edit.
BUILD_DIR = $builddir
CONFIGURE_ARGS = $*
CFG

echo "configure: build directory is '$builddir'; now run 'make'"
